# Required for Gemini-powered features
GEMINI_API_KEY=

# Current model can be changed without editing Python code.
GEMINI_MODEL=gemini-2.5-flash

# auto = use local LaMini when installed, otherwise Gemini
# local = require local LaMini and fail if unavailable
# gemini = always use Gemini for explanations
EXPLANATION_PROVIDER=auto

# Local model name used when EXPLANATION_PROVIDER=local/auto
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

# Application settings
APP_NAME=EduGenie
DEBUG=true
MAX_INPUT_CHARS=20000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
